# ==============================================================================
# NIVENTRA CAPITAL ADVISORY — ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Copy this file to .env.local for local development overrides.
# In production / Vercel, set these variables in the project settings dashboard.

# --- Core Runtime ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://niventra-capital-advisory.vercel.app
SESSION_SECRET=replace_with_a_secure_high_entropy_secret_at_least_64_characters_long

# --- Database & Persistence ---
# For local development: leaving empty defaults to local SQLite in /data or /tmp.
# For Vercel production: provide a PostgreSQL connection URI (Neon, Supabase, AWS RDS)
# or LibSQL / Turso connection URL.
# DATABASE_URL=postgresql://user:password@host:5432/niventra?sslmode=require

# --- Transactional Email Notifications ---
# Connect to Resend, SendGrid, or standard SMTP for inquiry & ticket notifications.
# Replaces local development email log (data/email_sink.log).
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM="Niventra Capital Advisory <notifications@niventracapitaladvisory.com>"
# ADVISORY_DESK_EMAIL="info@niventracapitaladvisory.com"

# --- Bot & Form Protection (Cloudflare Turnstile) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_your_site_key
# TURNSTILE_SECRET_KEY=0x4AAAAAA_your_secret_key

# --- AI Model Grounding (Optional LLM Integration) ---
# GEMINI_API_KEY=your_gemini_api_key_here
