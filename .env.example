# ==============================================================================
# NIVENTRA CAPITAL ADVISORY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local Next.js development.
# 2. Copy this file to backend/.env for local NestJS backend service.
# 3. For production (Vercel & Cloud Provider), configure these in hosting dashboards.
# 4. NEVER commit real secret values to version control.
# ==============================================================================

# --- Core Runtime & Cross-Origin Security ---
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=https://niventra-capital-advisory.vercel.app
# Leave NEXT_PUBLIC_API_BASE_URL unset in local Next.js-only mode.
# Set it (e.g. http://localhost:4000 or https://api-staging.niventracapitaladvisory.com) to route src/lib/api/client.ts to the standalone NestJS backend.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ORIGINS=https://niventra-capital-advisory.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Reverse proxy hops before NestJS (1 in staging/prod behind Railway/Render/Nginx; 0 in local dev)
TRUST_PROXY_HOPS=0
# Split-origin HTTPS cookie settings (in staging/production set COOKIE_SECURE=true and COOKIE_SAMESITE=none, or COOKIE_SAMESITE=lax on shared eTLD+1 subdomain)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.niventracapitaladvisory.com
# Disable Swagger /api/docs in production
SWAGGER_ENABLED=true

# --- Authentication & Session Security ---
# JWT Secret for NestJS API tokens (mandatory >=32 non-placeholder chars in staging and production)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_64_characters_long
# Dedicated HMAC key for CSRF tokens (optional; derives cleanly from JWT_SECRET when unset)
# CSRF_SECRET=replace_with_a_secure_csrf_secret_at_least_64_characters_long
JWT_EXPIRES_IN=15m

# --- Database & Persistence ---
# Local SQLite default (when DATABASE_URL is unset): uses data/niventra.db
# PostgreSQL connection string for staging / production (AWS RDS / Neon / Supabase):
DATABASE_URL=postgresql://user:password@host:5432/niventra?sslmode=require

# --- Transactional Email Notifications ---
# Outbound email provider (Resend or AWS SES). When unset, leads log to data/email_sink.log.
# RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Niventra Capital Advisory <notifications@niventracapitaladvisory.com>"
ADVISORY_DESK_EMAIL="info@niventracapitaladvisory.com"
LEAD_NOTIFICATION_EMAILS="info@niventracapitaladvisory.com"
STAFF_LEAD_NOTIFICATION_EMAILS="info@niventracapitaladvisory.com"

# --- Bot & Form Protection (Cloudflare Turnstile) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_your_site_key
# TURNSTILE_SECRET_KEY=0x4AAAAAA_your_secret_key

# --- Object Storage (Document Uploads & Due Diligence) ---
# Local document root override when using LOCAL_FS driver (default: ../storage/documents)
# STORAGE_ROOT_DIR=storage/documents
# S3 / Cloudflare R2 configuration for real estate project application documents
# S3_BUCKET_NAME=niventra-advisory-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key

# --- AI Grounding (Optional LLM Integration) ---
# GEMINI_API_KEY=your_gemini_api_key_here
