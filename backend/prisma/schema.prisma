// ==============================================================================
// NIVENTRA CAPITAL ADVISORY — PRODUCTION PRISMA SCHEMA (POSTGRESQL)
// ==============================================================================
// Identifier Strategy:
//   Primary keys default to UUIDs (`@default(uuid())`) and use `VARCHAR(128)` so
//   both newly issued UUIDs and migrated legacy SQLite string identifiers
//   (e.g., `usr_*`, `ENQ-2026-*`, `GRV-2026-*`, `prod_*`, `doc_*`) persist losslessly.
// Financial Precision:
//   All monetary amounts use `DECIMAL(18,2)` and rates use `DECIMAL(5,2)`.
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PUBLIC
  INVESTOR
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  PLOTTED_DEVELOPMENT
  REDEVELOPMENT
  INDUSTRIAL
  OTHER
}

enum ProjectStage {
  LAND_ACQUISITION
  PLANNING_APPROVALS
  UNDER_CONSTRUCTION
  COMPLETED
  OTHER
}

enum ProjectStatus {
  RECEIVED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  SHORTLISTED
  DECLINED
  CLOSED
}

enum PayoutFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUMULATIVE
}

enum InvestmentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  MATURED
  CANCELLED
}

enum TransactionType {
  PRINCIPAL_ALLOCATION
  INTEREST_PAYOUT
  TDS_DEDUCTION
  REDEMPTION
}

enum TransactionStatus {
  SCHEDULED
  PROCESSED
  FAILED
}

model User {
  id                  String        @id @default(uuid()) @db.VarChar(128)
  name                String        @db.VarChar(255)
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  salt                String        @db.VarChar(64)
  role                UserRole      @default(INVESTOR)
  phone               String?       @db.VarChar(50)
  investorCategory    String?       @map("investor_category") @db.VarChar(50)
  notifyConsultations Boolean       @default(true) @map("notify_consultations")
  notifyDisclosures   Boolean       @default(true) @map("notify_disclosures")
  notifyGrievances    Boolean       @default(true) @map("notify_grievances")
  status              AccountStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  kycRecord           KycRecord?
  enquiries           Enquiry[]               @relation("UserEnquiries")
  assignedEnqs        Enquiry[]               @relation("AssignedStaffEnquiries")
  grievances          Grievance[]             @relation("UserGrievances")
  assignedGrievances  Grievance[]             @relation("AssignedStaffGrievances")
  investments         Investment[]
  transactions        InvestmentTransaction[]
  notifications       Notification[]
  deletionReqs        DeletionRequest[]
  assignedPrjs        ProjectApplication[]    @relation("AssignedStaffProjects")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(128)
  userId    String   @map("user_id") @db.VarChar(128)
  token     String   @unique @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(128)
  userId    String    @map("user_id") @db.VarChar(128)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model KycRecord {
  id              String    @id @default(uuid()) @db.VarChar(128)
  userId          String    @unique @map("user_id") @db.VarChar(128)
  panMasked       String?   @map("pan_number_masked") @db.VarChar(20)
  idType          String?   @map("id_type") @db.VarChar(50)
  idNumberMasked  String?   @map("id_number_masked") @db.VarChar(50)
  status          KycStatus @default(NOT_SUBMITTED)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text
  dpdpConsent     Boolean   @default(true) @map("dpdp_consent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}

model Product {
  id              String   @id @default(uuid()) @db.VarChar(128)
  slug            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  indicativeYield String   @map("indicative_yield") @db.VarChar(50)
  tenor           String   @db.VarChar(50)
  minInvestment   String   @map("min_investment") @db.VarChar(50)
  securityType    String   @map("security_type") @db.VarChar(255)
  status          String   @default("PUBLISHED") @db.VarChar(50)
  summary         String   @db.Text
  description     String   @db.Text
  risksSummary    String   @map("risks_summary") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  investments Investment[]

  @@map("products")
}

model Document {
  id        String   @id @default(uuid()) @db.VarChar(128)
  title     String   @db.VarChar(255)
  docType   String   @map("doc_type") @db.VarChar(50)
  filePath  String   @map("file_path") @db.VarChar(500)
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  version   String   @default("1.0") @db.VarChar(32)
  isPublic  Boolean  @default(false) @map("is_public")
  status    String   @default("APPROVED") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isPublic, status])
  @@index([status])
  @@map("documents")
}

model Investment {
  id              String           @id @default(uuid()) @db.VarChar(128)
  userId          String           @map("user_id") @db.VarChar(128)
  productId       String?          @map("product_id") @db.VarChar(128)
  productTitle    String           @map("product_title") @db.VarChar(255)
  principalAmount Decimal          @map("principal_amount") @db.Decimal(18, 2)
  interestRatePa  Decimal          @map("interest_rate_pa") @db.Decimal(5, 2)
  tenorMonths     Int              @map("tenor_months")
  payoutFrequency PayoutFrequency  @map("payout_frequency")
  startDate       DateTime         @map("start_date") @db.Date
  maturityDate    DateTime         @map("maturity_date") @db.Date
  accruedInterest Decimal          @default(0) @map("accrued_interest") @db.Decimal(18, 2)
  interestPaid    Decimal          @default(0) @map("interest_paid") @db.Decimal(18, 2)
  pendingInterest Decimal          @default(0) @map("pending_interest") @db.Decimal(18, 2)
  nextPayoutDate  DateTime?        @map("next_payout_date") @db.Date
  status          InvestmentStatus @default(PENDING)
  isDemo          Boolean          @default(false) @map("is_demo")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions InvestmentTransaction[]

  @@index([userId])
  @@index([status])
  @@map("investments")
}

model InvestmentTransaction {
  id               String            @id @default(uuid()) @db.VarChar(128)
  investmentId     String            @map("investment_id") @db.VarChar(128)
  userId           String            @map("user_id") @db.VarChar(128)
  transactionType  TransactionType   @map("transaction_type")
  amount           Decimal           @db.Decimal(18, 2)
  status           TransactionStatus @default(SCHEDULED)
  paymentReference String?           @map("payment_reference") @db.VarChar(100)
  effectiveDate    DateTime          @map("effective_date") @db.Date
  isDemo           Boolean           @default(false) @map("is_demo")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([userId])
  @@map("investment_transactions")
}

model ProjectApplication {
  id                   String          @id @default(uuid()) @db.VarChar(128)
  referenceNumber      String          @unique @map("reference_number") @db.VarChar(50)
  applicantName        String          @map("applicant_name") @db.VarChar(255)
  organizationName     String          @map("organization_name") @db.VarChar(255)
  email                String          @db.VarChar(255)
  phone                String          @db.VarChar(50)
  role                 String          @db.VarChar(100)
  website              String?         @db.VarChar(255)
  projectName          String          @map("project_name") @db.VarChar(255)
  category             ProjectCategory
  address              String          @db.Text
  city                 String          @db.VarChar(100)
  state                String          @db.VarChar(100)
  pinCode              String          @map("pin_code") @db.VarChar(10)
  landStatus           String          @map("land_status") @db.VarChar(255)
  stage                ProjectStage
  description          String          @db.Text
  totalCost            Decimal         @map("total_cost") @db.Decimal(18, 2)
  fundingRequested     Decimal         @map("funding_requested") @db.Decimal(18, 2)
  promoterContribution Decimal?        @map("promoter_contribution") @db.Decimal(18, 2)
  useOfFunds           String          @map("use_of_funds") @db.Text
  expectedTimeline     String          @map("expected_timeline") @db.VarChar(255)
  existingLoans        String?         @map("existing_loans") @db.Text
  documents            Json            @default("[]")
  consentGiven         Boolean         @default(true) @map("consent_given")
  status               ProjectStatus   @default(RECEIVED)
  assignedTo           String?         @map("assigned_to") @db.VarChar(128)
  internalNotes        String?         @map("internal_notes") @db.Text
  declineReason        String?         @map("decline_reason") @db.Text
  infoRequested        String?         @map("info_requested") @db.Text
  isDemo               Boolean         @default(false) @map("is_demo")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  assignedStaff User?                  @relation("AssignedStaffProjects", fields: [assignedTo], references: [id], onDelete: SetNull)
  statusHistory ProjectStatusHistory[]

  @@index([referenceNumber])
  @@index([status])
  @@index([category])
  @@map("project_applications")
}

model ProjectStatusHistory {
  id             String         @id @default(uuid()) @db.VarChar(128)
  projectId      String         @map("project_id") @db.VarChar(128)
  previousStatus ProjectStatus? @map("previous_status")
  newStatus      ProjectStatus  @map("new_status")
  changedBy      String         @map("changed_by") @db.VarChar(255)
  changeNote     String?        @map("change_note") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  project ProjectApplication @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_status_history")
}

model Enquiry {
  id            String   @id @default(uuid()) @db.VarChar(128)
  referenceId   String   @unique @map("reference_id") @db.VarChar(50)
  userId        String?  @map("user_id") @db.VarChar(128)
  fullName      String   @map("full_name") @db.VarChar(255)
  email         String   @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(50)
  category      String   @db.VarChar(100)
  capitalRange  String   @map("capital_range") @db.VarChar(100)
  message       String?  @db.Text
  consent       Boolean  @default(true)
  status        String   @default("NEW") @db.VarChar(50)
  assignedTo    String?  @map("assigned_to") @db.VarChar(128)
  internalNotes String?  @map("internal_notes") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User? @relation("UserEnquiries", fields: [userId], references: [id], onDelete: SetNull)
  assignedStaff User? @relation("AssignedStaffEnquiries", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([referenceId])
  @@index([email])
  @@index([userId])
  @@map("enquiries")
}

model Grievance {
  id              String   @id @default(uuid()) @db.VarChar(128)
  ticketId        String   @unique @map("ticket_id") @db.VarChar(50)
  userId          String?  @map("user_id") @db.VarChar(128)
  complainantName String   @map("complainant_name") @db.VarChar(255)
  email           String   @db.VarChar(255)
  phone           String   @db.VarChar(50)
  transactionRef  String?  @map("transaction_ref") @db.VarChar(100)
  subject         String   @db.VarChar(255)
  description     String   @db.Text
  status          String   @default("SUBMITTED") @db.VarChar(50)
  assignedTo      String?  @map("assigned_to") @db.VarChar(128)
  resolutionNotes String?  @map("resolution_notes") @db.Text
  slaDeadline     DateTime @map("sla_deadline") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User? @relation("UserGrievances", fields: [userId], references: [id], onDelete: SetNull)
  assignedStaff User? @relation("AssignedStaffGrievances", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([status])
  @@index([userId])
  @@map("grievances")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.VarChar(128)
  actorId      String?  @map("actor_id") @db.VarChar(255)
  actorEmail   String?  @map("actor_email") @db.VarChar(255)
  actorRole    String?  @map("actor_role") @db.VarChar(50)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  details      Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  status       String   @default("SUCCESS") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorEmail])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(128)
  userId    String   @map("user_id") @db.VarChar(128)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model DeletionRequest {
  id                      String   @id @default(uuid()) @db.VarChar(128)
  requestId               String   @unique @map("request_id") @db.VarChar(50)
  userId                  String?  @map("user_id") @db.VarChar(128)
  fullName                String   @map("full_name") @db.VarChar(255)
  email                   String   @db.VarChar(255)
  phone                   String   @db.VarChar(50)
  reason                  String?  @db.Text
  status                  String   @default("PENDING") @db.VarChar(50)
  statutoryRetentionNotes String?  @map("statutory_retention_notes") @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([status])
  @@map("deletion_requests")
}
